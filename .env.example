# Copy to .env.local and fill in.

# Base URL of the Express backend. Leave blank in development to use the
# Vite dev proxy (see vite.config.js).
VITE_API_URL=

# Set to "false" once /api/analyze, /api/proposals, /api/portfolio,
# /api/learning and /api/chat are live. Any other value keeps the bundled
# demo dataset, which is what the booth demo runs on.
VITE_USE_MOCKS=true

# Deployed VentureDAO.sol address on Sepolia (used once contract calls
# replace the simulated receipts in src/lib/api.js).
VITE_CONTRACT_ADDRESS=

# Dev-only: where the Vite proxy forwards /api requests.
VITE_PROXY_TARGET=http://localhost:5000

# Same-origin path that proxies Yahoo Finance (equities + world indices).
# Defaults to /yf, which the Vite dev server and vercel.json already handle.
# Only set this if you serve the bridge somewhere else.
VITE_STOCK_PROXY=


# ─────────────────────────────────────────────────────────────
# Delta Exchange  (BACKEND ONLY — never prefix these with VITE_)
# ─────────────────────────────────────────────────────────────
# Anything named VITE_* is compiled into the browser bundle and is readable by
# anyone who opens devtools. These stay unprefixed so they live only in the
# Node process. Generate keys at Delta → Settings → API Keys, and restrict them
# by IP there as well.

DELTA_API_KEY=
DELTA_API_SECRET=

# Master key for encrypting stored exchange credentials at rest (AES-256-GCM).
# Required once per-user credential storage is enabled; the server refuses to
# start the vault without it rather than falling back to a default.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DELTA_VAULT_KEY=

# Which Delta universe your account and keys belong to. They are NOT
# interchangeable — a key made on one region fails authentication on the other.
#   global → demo.delta.exchange / delta.exchange   (USDT-quoted: ETHUSDT)
#   india  → testnet.delta.exchange / india.delta.exchange (USD-quoted: ETHUSD)
DELTA_REGION=global

# "testnet" (default) or "live".
# Testnet funds are worthless play tokens from a faucet — that is the point.
DELTA_ENV=testnet

# Live trading needs BOTH switches. Setting DELTA_ENV=live alone is treated as
# a mistake and falls back to testnet, because one typo should not be able to
# start moving real money.
DELTA_ALLOW_LIVE=false

# Hard ceiling on a single order's notional, enforced in the backend where the
# browser cannot reach it. Start small and raise it deliberately.
DELTA_MAX_ORDER_NOTIONAL=100

# Operator kill switch. "true" rejects every order-placing request.
DELTA_KILL_SWITCH=false

# Backend port and the origin allowed to call it.
PORT=5000
CORS_ORIGIN=http://localhost:5173

# NOTE: this file is a TEMPLATE and is committed to git. Never put real keys
# here — copy it to .env (which is gitignored) and fill that in instead.

# ─────────────────────────────────────────────────────────────
# MongoDB  (BACKEND ONLY — never prefix these with VITE_)
# ─────────────────────────────────────────────────────────────
# A connection string for anything other than a local server contains a
# username and password. VITE_ would compile it into the browser bundle, which
# for a database credential means publishing it. Leave these unprefixed.
#
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=venturedao

# Only read by server/scripts/migrateSqliteToMongo.js, to locate the old
# SQLite file. The application itself no longer uses it.
# DB_FILE=server/data/venturedao.db

# ─────────────────────────────────────────────────────────────
# Gemini  (BACKEND ONLY — never prefix this with VITE_)
# ─────────────────────────────────────────────────────────────
# Used to read sentiment out of market news headlines. It is NOT used to
# predict prices — a language model cannot forecast a price series, and asking
# it to would produce confident prose rather than a signal.
#
# VITE_ would compile this into the browser bundle, publishing your key and
# handing strangers your quota. Leave it unprefixed.
#
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
